@startuml erd
!include _style.iuml
hide circle
skinparam linetype ortho
title Database Schema (H2) - mapped from the Class Diagram

entity "customers" as customers {
  * customer_id : BIGINT <<PK, identity>>
  --
  * first_name : VARCHAR(50)
  * surname : VARCHAR(50)
  * national_id : VARCHAR(20) <<unique>>
  * address : VARCHAR(200)
  phone : VARCHAR(20)
  email : VARCHAR(100)
  * username : VARCHAR(50) <<unique>>
  * password_hash : VARCHAR(100)
  * salt : VARCHAR(50)
  created_at : TIMESTAMP
}

entity "employers" as employers {
  * employer_id : BIGINT <<PK, identity>>
  --
  * customer_id : BIGINT <<FK, unique>>
  * company_name : VARCHAR(100)
  * company_address : VARCHAR(200)
  job_title : VARCHAR(100)
}

entity "accounts" as accounts {
  * account_number : VARCHAR(20) <<PK>>
  --
  * customer_id : BIGINT <<FK>>
  * account_type : VARCHAR(20) <<SAVINGS|INVESTMENT|CHEQUE>>
  * branch : VARCHAR(100)
  * balance : DECIMAL(15,2) <<CHECK >= 0>>
  * date_opened : DATE
}

entity "transactions" as transactions {
  * transaction_id : BIGINT <<PK, identity>>
  --
  * account_number : VARCHAR(20) <<FK>>
  * transaction_type : VARCHAR(20)
  * amount : DECIMAL(15,2) <<CHECK > 0>>
  * balance_after : DECIMAL(15,2)
  * transaction_time : TIMESTAMP
  reference : VARCHAR(100)
}

entity "administrators" as administrators {
  * admin_id : BIGINT <<PK, identity>>
  --
  * username : VARCHAR(50) <<unique>>
  * full_name : VARCHAR(100)
  * password_hash : VARCHAR(100)
  * salt : VARCHAR(50)
}

customers ||--o| employers : "works for"
customers ||--o{ accounts : "holds"
accounts ||--o{ transactions : "records"
@enduml
